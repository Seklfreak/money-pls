// Copy this file to Secrets.xcconfig (gitignored) and fill in your values.
//
// Apple Developer team, needed for device builds (Xcode > Settings > Accounts).
DEVELOPMENT_TEAM =

// Sentry crash reporting (Project Settings -> Client Keys). Optional: leave
// empty to disable Sentry entirely. xcconfig treats // as a comment, so split
// the slashes with $(): https:/$()/<key>@<org>.ingest.us.sentry.io/<project>
SENTRY_DSN =
